{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:customer": "cross-env APP_VARIANT=customer expo start --clear --lan",
    "start:worker": "cross-env APP_VARIANT=worker expo start --clear --lan",
    "start:customer:tunnel": "cross-env APP_VARIANT=customer expo start --clear --tunnel",
    "start:worker:tunnel": "cross-env APP_VARIANT=worker expo start --clear --tunnel",
    "android": "expo run:android",
    "android:customer": "cross-env APP_VARIANT=customer expo run:android",
    "android:worker": "cross-env APP_VARIANT=worker expo run:android",
    "ios": "expo run:ios",
    "ios:customer": "cross-env APP_VARIANT=customer expo run:ios",
    "ios:worker": "cross-env APP_VARIANT=worker expo run:ios",
    "web": "expo start --web"
  },
