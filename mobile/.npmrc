# EAS Build runs `npm ci` which is strict about peer dependencies. This project
# uses an Expo canary release for expo-background-fetch that peers against a
# specific expo version, so installs fail with ERESOLVE without legacy-peer-deps.
#
# We hit the same wall locally — the earlier `npm install` for cross-env needed
# --legacy-peer-deps. Pinning it here so both EAS and any teammate's local
# install behaves consistently.
legacy-peer-deps=true
