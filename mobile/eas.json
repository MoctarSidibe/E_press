{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "APP_VARIANT": "customer",
        "EXPO_PUBLIC_API_URL": "https://epress.ga/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://epress.ga"
      },
      "android": { "buildType": "apk" },
      "channel": "production"
    },
    "production-customer": {
      "extends": "production",
      "env": {
        "NODE_ENV": "production",
        "APP_VARIANT": "customer",
        "EXPO_PUBLIC_API_URL": "https://epress.ga/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://epress.ga"
      },
      "channel": "production-customer"
    },
    "production-worker": {
      "extends": "production",
      "env": {
        "NODE_ENV": "production",
        "APP_VARIANT": "worker",
        "EXPO_PUBLIC_API_URL": "https://epress.ga/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://epress.ga"
      },
      "channel": "production-worker"
    }
  },
  "submit": {
    "production": {}
  }
}